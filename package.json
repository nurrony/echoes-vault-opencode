{
  "name": "echoes-vault-opencode",
  "version": "2.0.0",
  "description": "OpenCode adapter for the agent-neutral EchoesVault Protocol and repository-local Markdown memory runtime.",
  "type": "module",
  "main": "index.ts",
  "exports": {
    "./server": {
      "import": "./index.ts",
      "types": "./index.ts"
    },
    "./tui": {
      "import": "./tui.tsx",
      "types": "./tui.tsx"
    }
  },
  "files": [
    "index.ts",
    "runtime.ts",
    "tui.tsx",
    "prompts/commands/",
    "scripts/echoes_vault.py",
    "EchoesProtocol.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test tests/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "knowledge-base",
    "obsidian",
    "vault"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": ">=1.16.0 <2",
    "@opentui/solid": ">=0.4.3 <1",
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "toml": "^4.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/psinetron/echoes-vault-opencode.git"
  }
}
